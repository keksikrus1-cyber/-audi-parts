generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPPLIER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  REFUNDED
}

enum ProductType {
  ORIGINAL
  ANALOG
}

enum StockStatus {
  IN_STOCK
  ORDER_ONLY
  OUT_OF_STOCK
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String?       @map("display_name")
  phone        String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     AuthSession[]
  orders       Order[]
  supplier     Supplier?
  cartItems    CartItem[]
  favorites    Favorite[]
  vinRequests  VinRequest[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model Supplier {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String          @unique @db.Uuid @map("user_id")
  name              String
  shortCode         String?         @map("short_code")
  description       String?
  logoUrl           String?         @map("logo_url")
  rating            Float           @default(0)
  isVerified        Boolean         @default(false) @map("is_verified")
  isActive          Boolean         @default(true) @map("is_active")
  commissionPercent Decimal         @default(10) @db.Decimal(5, 2) @map("commission_percent")
  yookassaShopId    String?         @map("yookassa_shop_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts             Part[]
  offers            Offer[]

  @@map("suppliers")
}

model Category {
  id       String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @db.Uuid @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  parts    Part[]

  @@map("categories")
}

model Part {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  supplierId    String       @db.Uuid @map("supplier_id")
  categoryId    String?      @db.Uuid @map("category_id")
  name          String
  brand         String
  partNumber    String       @map("part_number")
  sku           String?
  oem           String?
  type          ProductType  @default(ANALOG)
  description   String?
  imageUrl      String?      @map("image_url")
  imageIcon     String?      @map("image_icon")
  compatibility String?
  isOriginal    Boolean      @default(false) @map("is_original")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  supplier      Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id])
  offers        Offer[]
  cartItems     CartItem[]
  favorites     Favorite[]

  @@index([partNumber], map: "parts_part_number_idx")
  @@index([sku], map: "parts_sku_idx")
  @@index([oem], map: "parts_oem_idx")
  @@index([brand], map: "parts_brand_idx")
  @@index([supplierId], map: "parts_supplier_id_idx")
  @@map("parts")
}

model Offer {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  partId        String      @db.Uuid @map("part_id")
  supplierId    String      @db.Uuid @map("supplier_id")
  price         Decimal     @db.Decimal(12, 2)
  stock         Int         @default(0)
  stockStatus   StockStatus @default(IN_STOCK) @map("stock_status")
  deliveryDays  Int         @default(1) @map("delivery_days")
  externalSku   String?     @map("external_sku")
  externalUrl   String?     @map("external_url")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  part          Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@unique([partId, supplierId])
  @@index([supplierId], map: "offers_supplier_id_idx")
  @@map("offers")
}

model Order {
  id                  String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String      @db.Uuid @map("user_id")
  status              OrderStatus @default(PENDING)
  totalAmount         Decimal     @db.Decimal(12, 2) @map("total_amount")
  address             String?
  yookassaPaymentId   String?     @unique @map("yookassa_payment_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payment             Payment?

  @@index([userId], map: "orders_user_id_idx")
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String  @db.Uuid @map("order_id")
  offerId           String  @db.Uuid @map("offer_id")
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2) @map("unit_price")
  supplierAmount    Decimal @db.Decimal(12, 2) @map("supplier_amount")
  platformFeeAmount Decimal @db.Decimal(12, 2) @map("platform_fee_amount")
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer             Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Payment {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String        @unique @db.Uuid @map("order_id")
  yookassaPaymentId String?       @unique @map("yookassa_payment_id")
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("RUB")
  confirmationUrl   String?       @map("confirmation_url")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WebhookLog {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  source      String
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([source, eventType], map: "webhook_logs_source_event_idx")
  @@map("webhook_logs")
}

model CartItem {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  partId     String   @db.Uuid @map("part_id")
  offerId    String?  @db.Uuid @map("offer_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([userId, partId, offerId])
  @@index([userId], map: "cart_items_user_id_idx")
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  partId    String   @db.Uuid @map("part_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
  @@index([userId], map: "favorites_user_id_idx")
  @@map("favorites")
}

model VinRequest {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String?  @db.Uuid @map("user_id")
  vin        String
  model      String?
  generation String?
  year       Int?
  body       String?
  plant      String?
  resultJson Json?    @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vin], map: "vin_requests_vin_idx")
  @@index([userId, createdAt], map: "vin_requests_user_created_idx")
  @@map("vin_requests")
}
